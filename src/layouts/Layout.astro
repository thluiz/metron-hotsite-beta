---
interface Props {
  title?: string;
}
const { title = 'Metron Showrunners' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Hybris — An Ancient Conflict, Reimagined. A Metron Showrunners original epic drama series."
    />
    <!-- Mesmo creme do letterbox da key art. -->
    <meta name="theme-color" content="#cabf9d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
