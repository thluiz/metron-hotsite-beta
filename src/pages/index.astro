---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---
<Layout title="Hybris — An Ancient Conflict, Reimagined | Metron Showrunners">

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/glightbox@3.3.1/dist/css/glightbox.min.css"
  />
  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/glightbox@3.3.1/dist/js/glightbox.min.js"
  ></script>

  <main class="keyart-wrap">
    <div
      class="keyart"
      role="region"
      aria-roledescription="carousel"
      aria-label="Metron Showrunners key art"
    >
      <div
        class="slide is-active"
        data-slide="0"
        role="group"
        aria-roledescription="slide"
        aria-label="1 of 6: Laya"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/laya-keyart-portrait.jpg?v=5"
          />
          <img
            src="/images/laya-keyart.jpg?v=5"
            alt="Laya — For love, she embraced eternity and relinquished her humanity. A Metron Showrunners Original Feature Film. Coming soon."
            class="keyart-img"
          />
        </picture>
        <a
          href="https://youtu.be/bXL5xmmQPys"
          class="footer-link glightbox"
          aria-label="Play the Laya teaser"
        ></a>
      </div>

      <div
        class="slide"
        data-slide="1"
        role="group"
        aria-roledescription="slide"
        aria-label="2 of 6: Inter/Sessions"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/intersessions-keyart-portrait.jpg?v=2"
          />
          <img
            src="/images/intersessions-keyart.jpg?v=2"
            alt="Inter/Sessions — No one stands alone. A Metron Showrunners Original Limited Series. Coming soon."
            class="keyart-img"
          />
        </picture>
      </div>

      <div
        class="slide"
        data-slide="2"
        role="group"
        aria-roledescription="slide"
        aria-label="3 of 6: Hybris"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/hybris-keyart-portrait.jpg?v=3"
          />
          <img
            src="/images/hybris-keyart.jpg?v=3"
            alt="Hybris — An Ancient Conflict, Reimagined. A Metron Showrunners Original Epic Drama Series."
            class="keyart-img"
          />
        </picture>
        <a
          href="https://files.hybris.world/"
          class="footer-link"
          aria-label="Hybris Project — access the materials"
        ></a>
      </div>

      <div
        class="slide"
        data-slide="3"
        role="group"
        aria-roledescription="slide"
        aria-label="4 of 6: Adorable Mrs. Steele"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/mrs-steele-keyart-portrait.jpg?v=2"
          />
          <img
            src="/images/mrs-steele-keyart.jpg?v=2"
            alt="Adorable Mrs. Steele. A Metron Showrunners Original Comedy Feature Film. Coming soon."
            class="keyart-img"
          />
        </picture>
      </div>

      <div
        class="slide"
        data-slide="4"
        role="group"
        aria-roledescription="slide"
        aria-label="5 of 6: Not Even Death"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/not-even-death-keyart-portrait.jpg?v=2"
          />
          <img
            src="/images/not-even-death-keyart.jpg?v=2"
            alt="Not Even Death — someone had to give up. A Metron Showrunners Original One-Minute Film."
            class="keyart-img is-ned"
          />
        </picture>
        <a
          href="https://files-ned.metronshowrunners.com/"
          class="footer-link"
          aria-label="Not Even Death — view the script"
        ></a>
      </div>

      <div
        class="slide"
        data-slide="5"
        role="group"
        aria-roledescription="slide"
        aria-label="6 of 6: Cell Phone"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/cell-phone-keyart-portrait.jpg?v=2"
          />
          <img
            src="/images/cell-phone-keyart.jpg?v=2"
            alt="Cell Phone — you're free to go. A Metron Showrunners Original Vertical Mobile Film. Coming soon."
            class="keyart-img"
          />
        </picture>
      </div>

      <button
        type="button"
        class="nav-arrow prev"
        data-nav="prev"
        aria-label="Previous key art"
      >
        <span aria-hidden="true">&#8249;</span>
      </button>
      <button
        type="button"
        class="nav-arrow next"
        data-nav="next"
        aria-label="Next key art"
      >
        <span aria-hidden="true">&#8250;</span>
      </button>

      <div class="dots" role="tablist" aria-label="Choose key art">
        <button
          type="button"
          class="dot is-active"
          data-dot="0"
          role="tab"
          aria-selected="true"
          aria-label="Show slide 1: Laya"
        ></button>
        <button
          type="button"
          class="dot"
          data-dot="1"
          role="tab"
          aria-selected="false"
          aria-label="Show slide 2: Inter/Sessions"
        ></button>
        <button
          type="button"
          class="dot"
          data-dot="2"
          role="tab"
          aria-selected="false"
          aria-label="Show slide 3: Hybris"
        ></button>
        <button
          type="button"
          class="dot"
          data-dot="3"
          role="tab"
          aria-selected="false"
          aria-label="Show slide 4: Adorable Mrs. Steele"
        ></button>
        <button
          type="button"
          class="dot"
          data-dot="4"
          role="tab"
          aria-selected="false"
          aria-label="Show slide 5: Not Even Death"
        ></button>
        <button
          type="button"
          class="dot"
          data-dot="5"
          role="tab"
          aria-selected="false"
          aria-label="Show slide 6: Cell Phone"
        ></button>
      </div>
    </div>
  </main>

  <section class="books" aria-labelledby="books-title" lang="pt-BR">
    <h2 id="books-title" class="books-title">Livros</h2>
    <div class="books-grid">
      <div class="book-item">
        <a
          href="https://a.co/d/074VoWqo"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Comprar Hybris, Livro 1: A História de Melissa — abre em nova janela"
        >
          <img
            class="book-cover"
            src="/images/books/hybris-livro-1-melissa.jpg?v=1"
            alt="Hybris, Livro 1: A História de Melissa — inspirado no mito da Medusa. De Julio Camacho e Guilherme Schlogel, adaptado por Rafael Doyle. Metron Publishing."
            loading="lazy"
            width="900"
            height="1414"
          />
        </a>
      </div>
      <div class="book-item">
        <a
          href="https://a.co/d/0gX00Jsc"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Comprar Hybris, Livro 2: A História de Peter — abre em nova janela"
        >
          <img
            class="book-cover"
            src="/images/books/hybris-livro-2-peter.jpg?v=1"
            alt="Hybris, Livro 2: A História de Peter — inspirado no mito de Perseu. De Julio Camacho e Guilherme Schlogel, adaptado por Rafael Doyle. Metron Publishing."
            loading="lazy"
            width="900"
            height="1414"
          />
        </a>
      </div>
      <div class="book-item">
        <a
          href="https://a.co/d/04kTKcmm"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Comprar Hybris, Livro 3: A História de Matthew — abre em nova janela"
        >
          <img
            class="book-cover"
            src="/images/books/hybris-livro-3-matthew.jpg?v=1"
            alt="Hybris, Livro 3: A História de Matthew — inspirado no mito de Midas. De Julio Camacho e Guilherme Schlogel, adaptado por Rafael Doyle. Metron Publishing."
            loading="lazy"
            width="900"
            height="1414"
          />
        </a>
      </div>
      <div class="book-item">
        <img
          class="book-cover"
          src="/images/books/hybris-livro-4-neville.jpg?v=1"
          alt="Hybris, Livro 4: A História de Neville — inspirado no mito de Narciso. De Julio Camacho e Guilherme Schlogel, adaptado por Rafael Doyle. Metron Publishing."
          loading="lazy"
          width="900"
          height="1414"
        />
      </div>
      <div class="book-item">
        <img
          class="book-cover"
          src="/images/books/hybris-livro-5-benedict.jpg?v=1"
          alt="Hybris, Livro 5: A História de Benedict — inspirado no mito de Belerofonte. De Julio Camacho e Guilherme Schlogel, adaptado por Rafael Doyle. Metron Publishing."
          loading="lazy"
          width="900"
          height="1414"
        />
      </div>
      <div class="book-item">
        <img
          class="book-cover"
          src="/images/books/hybris-livro-6-theo.jpg?v=1"
          alt="Hybris, Livro 6: A História de Theo — inspirado em um mito de Zeus. De Julio Camacho e Guilherme Schlogel, adaptado por Rafael Doyle. Metron Publishing."
          loading="lazy"
          width="900"
          height="1414"
        />
      </div>
      <div class="book-item">
        <img
          class="book-cover"
          src="/images/books/laya-livro.jpg?v=1"
          alt="Laya, de Julio Camacho. Metron Publishing."
          loading="lazy"
          width="900"
          height="1414"
        />
      </div>
    </div>
  </section>

</Layout>

<style>
  .keyart-wrap {
    position: relative;
    width: 100%;
    /* dvh tracks the real visible viewport on mobile (browser bar
       shows/hides) — plain vh measures as if it were always hidden, so
       it over/under-shoots. vh fallback for browsers without dvh. */
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    /* Only shows where the image doesn't reach. */
    background-color: #cabf9d;
  }

  /* Box with 16:9 aspect, fully inside the viewport. Changed from
     3070x2304 (~4:3) to 16:9 on 2026-09-18: on a wide/ultrawide monitor
     the old 4:3 was limited by height and left huge cream-colored bars on
     the sides. The 6 landscape art pieces already come in that format.

     The height, however, no longer locks to 100vw*9/16: that ceiling
     always forces the exact 16:9 aspect, and on more "square" screens
     (tablet in landscape, resized window) it left huge horizontal bars on
     top and bottom. Instead it only shrinks down to an aspect floor of
     1.45 — below that the art gets cropped on the sides via object-fit:
     cover (see .keyart-img) instead of the box continuing to shrink. 1.45
     was chosen because the side crop it produces (~9.2% on each side)
     stays under the safety margin measured pixel-by-pixel on the art:
     Laya's logo at ~11.4% from the left edge (the tightest of any
     logo/text), Hybris's man at ~10.8% from the left. Not Even Death has
     ~0 margin on the right (title flush against the edge), so it doesn't
     depend on this margin — see object-position on .is-ned. 2026-09-19:
     it was already 1.6 (crop ~5%); lowered to crop more as requested, but
     without blowing past Laya's margin — don't lower it further without
     remeasuring the art pixel-by-pixel. */
  .keyart {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width:  min(100vw, 100vh * 16 / 9);
    height: min(100vh, 100vw / 1.45);
    /* Height of the drawn art. Used to size overlaid text without relying
       on plain vh, which is wrong when the box is width-constrained. */
    --art-h: min(100vh, 100vw / 1.45);
  }

  /* Portrait (phone): the portrait art covers the whole screen (cropped
     via object-fit: cover), with no fixed-aspect box or cream bars.
     Fills .keyart-wrap via inset (not 100vw/100vh): vh units on mobile
     follow the "large viewport" (as if the browser bar were hidden),
     bigger than the actually visible area — with top:50%/translate(-50%)
     that overflowed symmetrically on top AND bottom, cropping the footer
     bar even with object-position: bottom. Inheriting the wrap's size
     (which via position:fixed already tracks the real visible viewport)
     avoids the mismatch. */
  @media (orientation: portrait) {
    .keyart {
      inset: 0;
      top: auto;
      left: auto;
      transform: none;
      width: 100%;
      height: 100%;
      /* In portrait the art is cropped by object-fit: cover, so what
         matters is the size of the drawn IMAGE, not the box. */
      --art-h: max(100vh, 100vw * 2329 / 1313);
    }
  }

  /* Stacked slides; the crossfade is opacity only. visibility disappears
     with a delay so the hidden slide's link isn't focusable/clickable. */
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease, visibility 0s linear 0.8s;
    z-index: 1;
  }
  .slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.8s ease, visibility 0s linear 0s;
    z-index: 2;
  }

  .keyart-img {
    display: block;
    width: 100%;
    height: 100%;
    /* cover, não fill: com o piso de aspect 1.6 do .keyart (acima), a caixa
       landscape nem sempre bate exatamente com o 16:9 da arte — fill
       esticaria a imagem. Cover crop sem deformar; como a caixa nunca fica
       mais "larga" que 16:9 (só mais "quadrada"), o corte é sempre lateral,
       nunca em cima/embaixo — daí object-position: top ser só uma garantia
       a mais, não algo que hoje entre em ação. */
    object-fit: cover;
    object-position: center top;
  }

  /* Not Even Death tem margem ~0 na borda direita da arte landscape (o "H"
     de DEATH quase toca o pixel 9216 de 9216). Ancorado à direita, qualquer
     corte lateral cai inteiro do lado esquerdo (fundo de chuva, sem texto),
     e a borda direita nunca é tocada. */
  .keyart-img.is-ned {
    object-position: right top;
  }

  @media (orientation: portrait) {
    .keyart-img {
      object-fit: cover; /* tela cheia, cropando bordas se preciso */
      /* 2026-09-19: a arte portrait nova também tem o botão desenhado no
         topo (mesma pílula do landscape), não mais a barra no rodapé — então
         o corte tem que proteger o TOPO agora, não mais embaixo. No aspect
         de aparelho comum (mais estreito que o 0,5625 da arte) o cover corta
         dos LADOS, não de cima/baixo, então "top" aqui é garantia extra —
         ver o mesmo raciocínio em .keyart-img (landscape) acima. */
      object-position: center top;
    }

    /* Not Even Death mantém o título quase encostado na borda direita
       também na arte portrait nova (margem ~0, igual à landscape). Ancorado
       à direita, o corte lateral cai inteiro do lado esquerdo. */
    .keyart-img.is-ned {
      object-position: right top;
    }
  }

  /* Botão clicável sobre a pílula desenhada na arte (topo-centro). Medido
     por pixel nas 6 artes novas — todas com o botão quase no mesmo lugar,
     ~x 32%–38% a 64%–68% (landscape 9216 / portrait 2916–2920) e y 0–5,5%
     — e generosamente arredondado num retângulo único que cobre as seis.
     Inter/Sessions, Mrs. Steele e Cell Phone têm o mesmo desenho de pílula
     ("Coming Soon"), mas sem destino: continuam sem elemento <a> no HTML.
     Trocou a arte, meça de novo. */
  .footer-link {
    position: absolute;
    left: 44%;
    right: 44%;
    top: 0;
    bottom: 94.8%;
    z-index: 3;
    transition: background-color 0.2s ease;
  }

  /* Em portrait o object-fit: cover (acima) croppa os LADOS da arte pra
     cobrir aparelhos mais estreitos que os 0,5625 dela — quanto mais
     estreito o aparelho, mais a arte "zoom" e mais pra fora (perto das
     bordas) o botão parece cair na tela. No aparelho mais estreito comum
     (~0,46, ex. iPhone 12/Pro Max) isso empurra o botão até uns 28%–72%;
     por isso a caixa aqui é mais larga que a do landscape (que não sofre
     esse deslocamento, já que a caixa dele é sempre >= 1.45 de aspect). */
  @media (orientation: portrait) {
    .footer-link {
      left: 25%;
      right: 25%;
      top: 0;
      bottom: 94%;
    }
  }

  .footer-link:hover {
    background-color: rgba(255, 255, 255, 0.14);
  }
  .footer-link:focus-visible {
    outline: 2px solid rgba(26, 18, 10, 0.75); /* escuro: o fundo aqui é claro */
    outline-offset: -2px;
  }

  /* Setas laterais, centralizadas na altura da arte (acima da barra do
     rodapé, que fica só no terço inferior). */
  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.28);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .nav-arrow:hover {
    background: rgba(0, 0, 0, 0.45);
    transform: translateY(-50%) scale(1.08);
  }
  .nav-arrow:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.95);
    outline-offset: 2px;
  }
  .nav-arrow.prev {
    left: 3%;
  }
  .nav-arrow.next {
    right: 3%;
  }

  /* Dots no terço inferior: em landscape o botão clicável fica no topo, longe
     daqui; em portrait (arte antiga) ficam acima da barra do rodapé, pra não
     brigar com a faixa clicável. */
  .dots {
    position: absolute;
    left: 50%;
    bottom: 12%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 4;
  }

  .dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.85);
    background: rgba(0, 0, 0, 0.25);
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .dot:hover {
    transform: scale(1.15);
  }
  .dot.is-active {
    background: rgba(255, 255, 255, 0.95);
  }
  .dot:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.95);
    outline-offset: 2px;
  }

  /* Segunda seção: livros da produtora, abaixo da key art (que agora ocupa
     só 100dvh em vez da tela toda via position: fixed). */
  .books {
    background-color: #cabf9d;
    padding: 64px 6% 96px;
  }

  .books-title {
    max-width: 1400px;
    margin: 0 auto 32px;
    font-size: clamp(22px, 4vw, 32px);
    letter-spacing: 0.02em;
  }

  /* 3 colunas em tela larga; cada capa portrait ocupa 1 coluna (3 por
     linha), cada capa landscape leva .is-landscape e ocupa a linha inteira
     (grid-column: 1 / -1) — 1 por linha. Em telas menores o grid cai pra 2
     e depois 1 coluna, então o "1 a 3 por linha" do pedido vem do
     viewport, não de um layout fixo por item. */
  .books-grid {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 24px;
  }

  .book-item.is-landscape {
    grid-column: 1 / -1;
  }

  .book-cover {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Link que cobre a capa inteira (ex.: livro à venda). A imagem já é o
     conteúdo clicável, então o link não tem texto visível próprio — só o
     aria-label. */
  .book-item a {
    display: block;
    transition: opacity 0.2s ease;
  }
  .book-item a:hover,
  .book-item a:focus-visible {
    opacity: 0.85;
  }
  .book-item a:focus-visible {
    outline: 2px solid rgba(26, 18, 10, 0.75);
    outline-offset: 2px;
  }

  @media (max-width: 900px) {
    .books-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .books-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.dot'));
  const prevButton = document.querySelector<HTMLButtonElement>('[data-nav="prev"]');
  const nextButton = document.querySelector<HTMLButtonElement>('[data-nav="next"]');
  const AUTOPLAY_MS = 6000;
  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  let current = 0;
  let timer: ReturnType<typeof setInterval> | undefined;

  function show(index: number) {
    current = index;
    slides.forEach((slide, i) =>
      slide.classList.toggle('is-active', i === index)
    );
    dots.forEach((dot, i) => {
      dot.classList.toggle('is-active', i === index);
      dot.setAttribute('aria-selected', String(i === index));
    });
  }

  function next() {
    show((current + 1) % slides.length);
  }

  function prev() {
    show((current - 1 + slides.length) % slides.length);
  }

  function restartAutoplay() {
    if (prefersReducedMotion || slides.length < 2) return;
    clearInterval(timer);
    timer = setInterval(next, AUTOPLAY_MS);
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      show(i);
      restartAutoplay();
    });
  });

  prevButton?.addEventListener('click', () => {
    prev();
    restartAutoplay();
  });

  nextButton?.addEventListener('click', () => {
    next();
    restartAutoplay();
  });

  restartAutoplay();

  // @ts-ignore — global from the GLightbox CDN <script>, no type declarations.
  GLightbox({ selector: '.glightbox' });
</script>
