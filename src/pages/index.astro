---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const year = new Date().getFullYear();
---
<Layout title="Hybris — An Ancient Conflict, Reimagined | Metron Showrunners">

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/glightbox@3.3.1/dist/css/glightbox.min.css"
  />
  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/glightbox@3.3.1/dist/js/glightbox.min.js"
  ></script>

  <main class="keyart-wrap">
    <div
      class="keyart"
      role="region"
      aria-roledescription="carousel"
      aria-label="Metron Showrunners key art"
    >
      <div
        class="slide is-active"
        data-slide="0"
        role="group"
        aria-roledescription="slide"
        aria-label="1 of 6: Laya"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/laya-keyart-portrait.jpg?v=5"
          />
          <img
            src="/images/laya-keyart.jpg?v=6"
            alt="Laya — For love, she embraced eternity and relinquished her humanity. A Metron Showrunners Original Feature Film. Coming soon."
            class="keyart-img"
          />
        </picture>
        <a
          href="https://youtu.be/bXL5xmmQPys"
          class="footer-link glightbox"
          aria-label="Play the Laya teaser"
        ></a>
      </div>

      <div
        class="slide"
        data-slide="1"
        role="group"
        aria-roledescription="slide"
        aria-label="2 of 6: Inter/Sessions"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/intersessions-keyart-portrait.jpg?v=2"
          />
          <img
            src="/images/intersessions-keyart.jpg?v=6"
            alt="Inter/Sessions — No one stands alone. A Metron Showrunners Original Limited Series. Coming soon."
            class="keyart-img"
          />
        </picture>
      </div>

      <div
        class="slide"
        data-slide="2"
        role="group"
        aria-roledescription="slide"
        aria-label="3 of 6: Hybris"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/hybris-keyart-portrait.jpg?v=3"
          />
          <img
            src="/images/hybris-keyart.jpg?v=6"
            alt="Hybris — An Ancient Conflict, Reimagined. A Metron Showrunners Original Epic Drama Series."
            class="keyart-img"
          />
        </picture>
        <a
          href="https://files.hybris.world/"
          class="footer-link"
          aria-label="Hybris Project — access the materials"
        ></a>
      </div>

      <div
        class="slide"
        data-slide="3"
        role="group"
        aria-roledescription="slide"
        aria-label="4 of 6: Adorable Mrs. Steele"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/mrs-steele-keyart-portrait.jpg?v=2"
          />
          <img
            src="/images/mrs-steele-keyart.jpg?v=6"
            alt="Adorable Mrs. Steele. A Metron Showrunners Original Comedy Feature Film. Coming soon."
            class="keyart-img"
          />
        </picture>
      </div>

      <div
        class="slide is-ned-slide"
        data-slide="4"
        role="group"
        aria-roledescription="slide"
        aria-label="5 of 6: Not Even Death"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/not-even-death-keyart-portrait.jpg?v=2"
          />
          <img
            src="/images/not-even-death-keyart.jpg?v=6"
            alt="Not Even Death — someone had to give up. A Metron Showrunners Original One-Minute Film."
            class="keyart-img is-ned"
          />
        </picture>
        <a
          href="https://files-ned.metronshowrunners.com/"
          class="footer-link"
          aria-label="Not Even Death — view the script"
        ></a>
      </div>

      <div
        class="slide"
        data-slide="5"
        role="group"
        aria-roledescription="slide"
        aria-label="6 of 6: Cell Phone"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/cell-phone-keyart-portrait.jpg?v=2"
          />
          <img
            src="/images/cell-phone-keyart.jpg?v=6"
            alt="Cell Phone — you're free to go. A Metron Showrunners Original Vertical Mobile Film. Coming soon."
            class="keyart-img"
          />
        </picture>
      </div>

      <button
        type="button"
        class="nav-arrow prev"
        data-nav="prev"
        aria-label="Previous key art"
      >
        <span aria-hidden="true">&#8249;</span>
      </button>
      <button
        type="button"
        class="nav-arrow next"
        data-nav="next"
        aria-label="Next key art"
      >
        <span aria-hidden="true">&#8250;</span>
      </button>

      <div class="dots" role="tablist" aria-label="Choose key art">
        <button
          type="button"
          class="dot is-active"
          data-dot="0"
          role="tab"
          aria-selected="true"
          aria-label="Show slide 1: Laya"
        ></button>
        <button
          type="button"
          class="dot"
          data-dot="1"
          role="tab"
          aria-selected="false"
          aria-label="Show slide 2: Inter/Sessions"
        ></button>
        <button
          type="button"
          class="dot"
          data-dot="2"
          role="tab"
          aria-selected="false"
          aria-label="Show slide 3: Hybris"
        ></button>
        <button
          type="button"
          class="dot"
          data-dot="3"
          role="tab"
          aria-selected="false"
          aria-label="Show slide 4: Adorable Mrs. Steele"
        ></button>
        <button
          type="button"
          class="dot"
          data-dot="4"
          role="tab"
          aria-selected="false"
          aria-label="Show slide 5: Not Even Death"
        ></button>
        <button
          type="button"
          class="dot"
          data-dot="5"
          role="tab"
          aria-selected="false"
          aria-label="Show slide 6: Cell Phone"
        ></button>
      </div>
    </div>
  </main>

  <section class="books" aria-labelledby="books-title">
    <div class="books-header">
      <h2 id="books-title" class="books-title">Metron Publishing</h2>
      <p class="books-subtitle">Stories beyond the screen.</p>
    </div>
    <div class="books-carousel">
      <button
        type="button"
        class="books-nav prev"
        data-books-nav="prev"
        aria-label="Previous titles"
      >
        <span aria-hidden="true">&#8249;</span>
      </button>
      <div class="books-track">
      <div class="book-item">
        <a
          href="https://a.co/d/074VoWqo"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Buy Hybris, Book 1: Melissa's Story — opens in a new window"
        >
          <img
            class="book-cover"
            src="/images/books/hybris-livro-1-melissa.jpg?v=1"
            alt="Hybris, Book 1: Melissa's Story — inspired by the myth of Medusa. By Julio Camacho and Guilherme Schlogel, adapted by Rafael Doyle. Metron Publishing."
            loading="lazy"
            width="900"
            height="1414"
          />
        </a>
        <div class="book-caption">
          <p class="book-caption-title">Book 1: Melissa's Story</p>
          <div class="book-caption-tags">
            <span class="book-caption-tag">Medusa Myth</span>
            <span class="book-caption-tag">2024</span>
          </div>
        </div>
      </div>
      <div class="book-item">
        <a
          href="https://a.co/d/0gX00Jsc"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Buy Hybris, Book 2: Peter's Story — opens in a new window"
        >
          <img
            class="book-cover"
            src="/images/books/hybris-livro-2-peter.jpg?v=1"
            alt="Hybris, Book 2: Peter's Story — inspired by the myth of Perseus. By Julio Camacho and Guilherme Schlogel, adapted by Rafael Doyle. Metron Publishing."
            loading="lazy"
            width="900"
            height="1414"
          />
        </a>
        <div class="book-caption">
          <p class="book-caption-title">Book 2: Peter's Story</p>
          <div class="book-caption-tags">
            <span class="book-caption-tag">Perseus Myth</span>
            <span class="book-caption-tag">2025</span>
          </div>
        </div>
      </div>
      <div class="book-item">
        <a
          href="https://a.co/d/04kTKcmm"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Buy Hybris, Book 3: Matthew's Story — opens in a new window"
        >
          <img
            class="book-cover"
            src="/images/books/hybris-livro-3-matthew.jpg?v=1"
            alt="Hybris, Book 3: Matthew's Story — inspired by the myth of Midas. By Julio Camacho and Guilherme Schlogel, adapted by Rafael Doyle. Metron Publishing."
            loading="lazy"
            width="900"
            height="1414"
          />
        </a>
        <div class="book-caption">
          <p class="book-caption-title">Book 3: Matthew's Story</p>
          <div class="book-caption-tags">
            <span class="book-caption-tag">Midas Myth</span>
            <span class="book-caption-tag">2026</span>
          </div>
        </div>
      </div>
      <div class="book-item">
        <img
          class="book-cover"
          src="/images/books/hybris-livro-4-neville.jpg?v=1"
          alt="Hybris, Book 4: Neville's Story — inspired by the myth of Narcissus. By Julio Camacho and Guilherme Schlogel, adapted by Rafael Doyle. Metron Publishing."
          loading="lazy"
          width="900"
          height="1414"
        />
        <div class="book-caption">
          <p class="book-caption-title">Book 4: Neville's Story</p>
          <div class="book-caption-tags">
            <span class="book-caption-tag">Narcissus Myth</span>
            <span class="book-caption-tag book-caption-tag--coming">Coming October 2026</span>
          </div>
        </div>
      </div>
      <div class="book-item">
        <img
          class="book-cover"
          src="/images/books/hybris-livro-5-benedict.jpg?v=1"
          alt="Hybris, Book 5: Benedict's Story — inspired by the myth of Bellerophon. By Julio Camacho and Guilherme Schlogel, adapted by Rafael Doyle. Metron Publishing."
          loading="lazy"
          width="900"
          height="1414"
        />
        <div class="book-caption">
          <p class="book-caption-title">Book 5: Benedict's Story</p>
          <div class="book-caption-tags">
            <span class="book-caption-tag">Bellerophon Myth</span>
            <span class="book-caption-tag book-caption-tag--coming">Coming March 2027</span>
          </div>
        </div>
      </div>
      <div class="book-item">
        <img
          class="book-cover"
          src="/images/books/hybris-livro-6-theo.jpg?v=1"
          alt="Hybris, Book 6: Theo's Story — inspired by a myth of Zeus. By Julio Camacho and Guilherme Schlogel, adapted by Rafael Doyle. Metron Publishing."
          loading="lazy"
          width="900"
          height="1414"
        />
        <div class="book-caption">
          <p class="book-caption-title">Book 6: Theo's Story</p>
          <div class="book-caption-tags">
            <span class="book-caption-tag">Zeus Myth</span>
            <span class="book-caption-tag book-caption-tag--coming">Coming October 2027</span>
          </div>
        </div>
      </div>
      <div class="book-item">
        <img
          class="book-cover"
          src="/images/books/laya-livro.jpg?v=1"
          alt="Laya, by Julio Camacho. Metron Publishing."
          loading="lazy"
          width="900"
          height="1414"
        />
        <div class="book-caption">
          <p class="book-caption-title">Laya</p>
          <div class="book-caption-tags">
            <span class="book-caption-tag book-caption-tag--coming">Coming 2027</span>
          </div>
        </div>
      </div>
      </div>
      <button
        type="button"
        class="books-nav next"
        data-books-nav="next"
        aria-label="Next titles"
      >
        <span aria-hidden="true">&#8250;</span>
      </button>
    </div>
  </section>

  <footer class="site-footer">
    <p class="site-footer-brand">Metron Showrunners</p>
    <nav class="site-footer-links" aria-label="Project links">
      <a href="https://youtu.be/bXL5xmmQPys" class="glightbox">Laya Trailer</a>
      <span class="site-footer-sep" aria-hidden="true">&#183;</span>
      <a href="https://files.hybris.world/">Hybris Project</a>
      <span class="site-footer-sep" aria-hidden="true">&#183;</span>
      <a href="https://files-ned.metronshowrunners.com/">Not Even Death Script</a>
    </nav>
    <p class="site-footer-copy">&#169; {year} Metron Showrunners. All rights reserved.</p>
  </footer>

</Layout>

<style>
  .keyart-wrap {
    position: relative;
    width: 100%;
    /* dvh tracks the real visible viewport on mobile (browser bar
       shows/hides) — plain vh measures as if it were always hidden, so
       it over/under-shoots. vh fallback for browsers without dvh. */
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    /* The art now covers this box entirely, so this only shows in the
       instant before the image decodes. Matches the page background (body,
       global.css) and the Books section below, so that instant reads as
       the same dark canvas rather than a cream flash. */
    background-color: #05091a;
  }

  /* The carousel's frame: fills .keyart-wrap edge to edge, on every
     screen. It no longer sizes the art — the art overflows it (see
     .slide). Arrows and dots hang off this box, not off the art, so they
     stay on screen even where the art is cropped. */
  .keyart {
    position: absolute;
    inset: 0;
  }

  /* Stacked slides; the crossfade is opacity only. visibility disappears
     with a delay so the hidden slide's link isn't focusable/clickable.

     A slide IS the rectangle the art is drawn into, and in landscape that
     rectangle deliberately OVERFLOWS the viewport: it is the smallest box of
     the ART'S OWN ASPECT that still covers .keyart-wrap completely —
     max(), not min().
     So the art reaches all four edges on any screen, and .keyart-wrap's
     overflow:hidden clips whatever sticks out.

     2026-09-21: this replaced a box that had to FIT inside the viewport
     (16:9 ceiling, 1.45 aspect floor), which by construction left bars on
     any screen outside that range. Filling the hero was asked for
     explicitly, with the cost accepted: the overflow crops the art —
     the bottom on a screen wider than the art, the sides on a squarer one
     — and the title baked into the art can end up partly off-screen. The
     drawn button survives either way: it sits top-centre, the two places
     cover never crops. That is the trade, not a bug to fix by bringing
     a fitted box back.

     The box being exactly the art's aspect (3840x2007) and anchored the
     way object-fit: cover anchors it means percentage overlays inside a
     slide (.footer-link) still land on the drawn art — for as long as
     that part of the art is on screen at all. */
  .slide {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    /* The art's own aspect, 3840x2007 (1.9133) since 2026-09-21. It is NOT
       16:9 any more — the new pieces came in at 9211x4815, wider than the
       old 3840x2160. These four numbers and the art must agree exactly, or
       object-fit: cover starts cropping inside the box too and the button
       hotspot below drifts off the drawn pill. New art, change them.
       dvh pair for the same reason as .keyart-wrap; vh first, as the
       fallback for browsers without dvh. */
    width:  max(100vw, 100vh * 3840 / 2007);
    width:  max(100vw, 100dvh * 3840 / 2007);
    height: max(100vh, 100vw * 2007 / 3840);
    height: max(100dvh, 100vw * 2007 / 3840);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease, visibility 0s linear 0.8s;
    z-index: 1;
  }
  .slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.8s ease, visibility 0s linear 0s;
    z-index: 2;
  }

  /* Not Even Death keeps almost no margin on the right of its landscape
     art: remeasured on the 2026-09-21 piece, the "H" in DEATH runs to
     ~99.3% of the width. Anchoring the box right throws the whole
     horizontal overflow to the left, so the title survives.

     Unlike the previous art, this one also has content near the LEFT edge
     (the car/figures icons start at ~3.6%, "someone had to give up" at
     ~5%), so the anchor is no longer free: on anything squarer than ~1.84
     it eats that tagline. Centring instead would clip the title's H by
     ~2.8% at 16:9. Kept anchored because the title is the brand; it is a
     judgement call, not a measurement. */
  .slide.is-ned-slide {
    left: auto;
    right: 0;
    transform: none;
  }

  /* Portrait (phone): unchanged behaviour — the slide simply fills
     .keyart-wrap and object-fit: cover on the <img> crops the portrait art
     (1600x2844). Sized by inset/100%, never by vh: on mobile vh follows
     the "large viewport" (as if the browser bar were hidden), which is
     bigger than the visible area, and a centred box that size overflowed
     on top AND bottom. The wrap already tracks the real visible viewport,
     so inheriting its size avoids the mismatch. */
  @media (orientation: portrait) {
    .slide,
    .slide.is-ned-slide {
      inset: 0;
      transform: none;
      width: 100%;
      height: 100%;
    }
  }

  .keyart-img {
    display: block;
    width: 100%;
    height: 100%;
    /* In landscape the slide box is already exactly the art's 16:9, so
       cover scales it with nothing left to crop at this level — the
       cropping happens one level up, where the box overflows the viewport.
       In portrait the box IS the viewport and cover does the cropping.
       Kept as cover rather than fill so that a future piece of art that
       isn't pixel-exact gets cropped instead of stretched. */
    object-fit: cover;
    object-position: center top;
  }

  /* Portrait art: the title sits nearly flush against the right edge, so
     anchoring right keeps the side crop off it. In landscape it is the box
     itself that's anchored right — see .slide.is-ned-slide. */
  .keyart-img.is-ned {
    object-position: right top;
  }

  @media (orientation: portrait) {
    .keyart-img {
      object-fit: cover; /* full screen, cropping edges if needed */
      /* 2026-09-19: the new portrait art also has the button drawn at the
         top (same pill as landscape), no longer the footer bar — so the
         crop now has to protect the TOP, not the bottom anymore. On a
         common device aspect (narrower than the art's 0.5625) cover crops
         the SIDES, not top/bottom, so "top" here is extra insurance — same
         reasoning as .keyart-img (landscape) above. */
      object-position: center top;
    }

    /* Not Even Death keeps the title nearly flush against the right edge
       on the new portrait art too (~0 margin, same as landscape). Anchored
       to the right, the side crop falls entirely on the left. */
    .keyart-img.is-ned {
      object-position: right top;
    }
  }

  /* Clickable button over the pill drawn on the art (top-centre).
     Remeasured on the 2026-09-21 landscape art (9211x4815 sources) with a
     percentage ruler over each piece: the pill sits at x 45.2%–54.8%,
     y 1.6%–7.0% on all six. It is the same fixed-width pill everywhere —
     only the label inside changes ("Watch Teaser", "View Project", "View
     Script", "Coming Soon") — so one box serves all six. Note this is a
     lot narrower than the previous art's pill (x 32%–68%): a hotspot
     carried over from it would hang off the sides.

     The box below is inset inside the measured pill on every side, so
     rounding and per-piece drift can't put it on bare art. Inter/Sessions,
     Mrs. Steele and Cell Phone have the same pill but no destination: they
     stay without an <a> element in the HTML. Art changed, remeasure.

     The percentages are of the SLIDE, which is the drawn art exactly (see
     .slide) — so they follow the art instead of drifting with the crop. */
  .footer-link {
    position: absolute;
    left: 46%;
    right: 46%;
    top: 2.5%;
    bottom: 93.8%;
    z-index: 3;
    transition: background-color 0.2s ease;
  }

  /* In portrait, object-fit: cover (above) crops the SIDES of the art to
     cover devices narrower than its 0.5625 — the narrower the device, the
     more the art "zooms" and the further out (toward the edges) the
     button appears to land on screen. On the narrowest common device
     (~0.46, e.g. iPhone 12/Pro Max) this pushes the button out to about
     28%–72%; that's why this box is wider than the landscape one
     (whose box is the drawn art itself, so it doesn't shift). The portrait
     art was NOT replaced on 2026-09-21, so these numbers still stand. */
  @media (orientation: portrait) {
    .footer-link {
      left: 25%;
      right: 25%;
      top: 0;
      bottom: 94%;
    }
  }

  .footer-link:hover {
    background-color: rgba(255, 255, 255, 0.14);
  }
  .footer-link:focus-visible {
    outline: 2px solid rgba(26, 18, 10, 0.75); /* dark: the background here is light */
    outline-offset: -2px;
  }

  /* Side arrows, centered on the art's height (above the footer bar,
     which sits only in the bottom third). */
  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.28);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .nav-arrow:hover {
    background: rgba(0, 0, 0, 0.45);
    transform: translateY(-50%) scale(1.08);
  }
  .nav-arrow:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.95);
    outline-offset: 2px;
  }
  .nav-arrow.prev {
    left: 3%;
  }
  .nav-arrow.next {
    right: 3%;
  }

  /* Dots in the bottom third: in landscape the clickable button is at the
     top, far from here; in portrait (old art) they sit above the footer
     bar, to avoid clashing with the clickable strip. */
  .dots {
    position: absolute;
    left: 50%;
    bottom: 12%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 4;
  }

  .dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.85);
    background: rgba(0, 0, 0, 0.25);
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .dot:hover {
    transform: scale(1.15);
  }
  .dot.is-active {
    background: rgba(255, 255, 255, 0.95);
  }
  .dot:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.95);
    outline-offset: 2px;
  }

  /* Second section: the studio's books, below the key art (which now only
     takes up 100dvh instead of the whole screen via position: fixed). */
  .books {
    background-color: #05091a;
    color: #f2ede2;
    padding: 64px 6% 96px;
  }

  .books-header {
    max-width: 1400px;
    margin: 0 auto 40px;
  }

  .books-title {
    margin: 0;
    font-size: clamp(24px, 4vw, 34px);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f2ede2;
  }

  .books-subtitle {
    margin: 8px 0 0;
    font-size: clamp(14px, 2vw, 18px);
    color: #f2ede2;
    opacity: 0.65;
  }

  /* Horizontal carousel instead of a grid: covers were reading too big
     stacked 3-per-row, so all titles now sit in a single scroll-snapped
     row. Cards are a fixed-ish width (--book-w, fluid between a phone and
     a wide desktop floor/ceiling) rather than dividing the container into
     a set number of columns — how many fit per screen is just whatever
     width allows, which lands on ~2 on a phone in portrait without a
     dedicated breakpoint. .is-landscape (unused today, kept for a future
     landscape cover) spans double a card's width plus the gap. */
  .books-carousel {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .books-track {
    --book-w: clamp(130px, 15vw, 190px);
    --books-gap: 52px;
    display: flex;
    gap: var(--books-gap);
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 14px 4px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .books-track::-webkit-scrollbar {
    display: none;
  }

  .book-item {
    flex: 0 0 var(--book-w);
    scroll-snap-align: start;
  }

  .book-item.is-landscape {
    flex-basis: calc(2 * var(--book-w) + var(--books-gap));
  }

  .book-cover {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
    /* Lifts the cover off the dark background; grows on hover/focus so the
       picked title visibly "pops" toward the viewer. */
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.55);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .book-item:hover .book-cover,
  .book-item a:focus-visible .book-cover {
    box-shadow: 0 18px 34px rgba(0, 0, 0, 0.8);
    transform: translateY(-6px) scale(1.04);
  }

  /* Link that covers the whole cover (e.g.: book for sale). The image is
     already the clickable content, so the link has no visible text of its
     own — just the aria-label. The caption below is separate, plain text
     naming the book, not part of the link. */
  .book-item a {
    display: block;
  }
  .book-item a:focus-visible {
    outline: 2px solid rgba(242, 237, 226, 0.85);
    outline-offset: 2px;
  }

  /* Styled after a Macmillan Publishers book-grid reference: plain-weight
     title, smaller muted byline, small rounded tag — adapted to the dark
     background instead of that reference's white one. */
  .book-caption {
    margin: 12px 0 0;
    text-align: left;
  }

  .book-caption-title {
    margin: 0;
    font-size: 14px;
    line-height: 1.3;
    font-weight: 600;
    color: #f2ede2;
  }

  .book-caption-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  .book-caption-tag {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 999px;
    background: rgba(242, 237, 226, 0.12);
    color: #f2ede2;
    font-size: 11px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* Pre-release titles: warm accent (the site's old letterbox cream) so
     "coming soon" reads as distinct from a myth tag or a release year. */
  .book-caption-tag--coming {
    background: rgba(202, 191, 157, 0.22);
    color: #cabf9d;
  }

  .books-nav {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(242, 237, 226, 0.12);
    color: #f2ede2;
    font-size: 22px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .books-nav:hover {
    background: rgba(242, 237, 226, 0.22);
    transform: scale(1.08);
  }
  .books-nav:focus-visible {
    outline: 2px solid rgba(242, 237, 226, 0.85);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .books-nav {
      width: 32px;
      height: 32px;
      font-size: 18px;
    }
  }

  /* Closing footer: same dark canvas as .books, so the page ends as one
     continuous surface instead of a third background color. */
  .site-footer {
    background-color: #05091a;
    color: #f2ede2;
    padding: 32px 6% 40px;
    border-top: 1px solid rgba(242, 237, 226, 0.14);
    text-align: center;
  }

  .site-footer-brand {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .site-footer-links {
    margin: 14px 0 0;
    font-size: 13px;
  }

  .site-footer-links a {
    color: #f2ede2;
    text-decoration: none;
    border-bottom: 1px solid rgba(242, 237, 226, 0.4);
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }

  .site-footer-links a:hover,
  .site-footer-links a:focus-visible {
    border-color: rgba(242, 237, 226, 0.9);
  }

  .site-footer-links a:focus-visible {
    outline: 2px solid rgba(242, 237, 226, 0.85);
    outline-offset: 3px;
  }

  .site-footer-sep {
    margin: 0 10px;
    opacity: 0.5;
  }

  .site-footer-copy {
    margin: 18px 0 0;
    font-size: 11px;
    opacity: 0.5;
  }
</style>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.dot'));
  const prevButton = document.querySelector<HTMLButtonElement>('[data-nav="prev"]');
  const nextButton = document.querySelector<HTMLButtonElement>('[data-nav="next"]');
  const AUTOPLAY_MS = 6000;
  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  let current = 0;
  let timer: ReturnType<typeof setInterval> | undefined;

  function show(index: number) {
    current = index;
    slides.forEach((slide, i) =>
      slide.classList.toggle('is-active', i === index)
    );
    dots.forEach((dot, i) => {
      dot.classList.toggle('is-active', i === index);
      dot.setAttribute('aria-selected', String(i === index));
    });
  }

  function next() {
    show((current + 1) % slides.length);
  }

  function prev() {
    show((current - 1 + slides.length) % slides.length);
  }

  function restartAutoplay() {
    if (prefersReducedMotion || slides.length < 2) return;
    clearInterval(timer);
    timer = setInterval(next, AUTOPLAY_MS);
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      show(i);
      restartAutoplay();
    });
  });

  prevButton?.addEventListener('click', () => {
    prev();
    restartAutoplay();
  });

  nextButton?.addEventListener('click', () => {
    next();
    restartAutoplay();
  });

  restartAutoplay();

  // @ts-ignore — global from the GLightbox CDN <script>, no type declarations.
  const lightbox = GLightbox({ selector: '.glightbox' });
  // The carousel autoplay keeps advancing slides behind the video overlay
  // otherwise — pause it while the lightbox is open, resume on close.
  lightbox.on('open', () => clearInterval(timer));
  lightbox.on('close', () => restartAutoplay());

  const booksTrack = document.querySelector<HTMLElement>('.books-track');
  const booksPrev = document.querySelector<HTMLButtonElement>(
    '[data-books-nav="prev"]'
  );
  const booksNext = document.querySelector<HTMLButtonElement>(
    '[data-books-nav="next"]'
  );

  // Infinite CSS scroll-snap carousel. The row of covers is cloned once
  // before and once after the real one; the scroll rests in the middle copy;
  // navigation is by INDEX, and every scroll target is read from the target
  // cover's own offsetLeft. Nothing is computed from a cover width or a gap.
  //
  // That last point is the whole design, and it took three tries to get here:
  //
  //   1. scrollBy(clientWidth) with an instant jump at the ends. One "page"
  //      is 5.35 covers (1296px) while the entire scrollable range is 354px
  //      — seven 190px covers in a 1296px viewport barely overflow — so
  //      every click slammed into the clamp. A teleport, not a scroll.
  //
  //   2. Rotating one cover through the DOM and correcting the scroll to hide
  //      the move. The correction has to survive `scroll-snap-type:
  //      mandatory`, which drags any programmatic scroll to the nearest snap
  //      point, and at the right-hand end the resting position is the scroll
  //      clamp — not a snap point. Traced: a correction aimed at 112px landed
  //      on 246px, a 134px one-frame jump. Exactly what it meant to hide.
  //
  //   3. Cloning (as here) but stepping by a measured pitch and folding on a
  //      pixel threshold. The pitch is fractional at some widths (182.5px on
  //      a 390px phone), so every click drifted by half a pixel and snapping
  //      yanked it back: measured net steps of -185, -183, -191 instead of a
  //      clean -182. And the pixel fold raced the animation, producing net
  //      steps of +1021 then -53 where -242 was due.
  //
  // Indices fix both: an index is exact, and `offsetLeft` is the real laid-out
  // position, so a target is always precisely a snap point and snapping has
  // nothing to drag. Folding happens BEFORE the animation, never against it.
  // If you touch this, measure the net scroll per click — it must be one
  // cover every time, at every width.
  const BOOKS_EDGE_TOLERANCE = 12; // rounding/padding leave scrollLeft a few px off 0 at rest
  const BOOKS_SETTLE_MS = 140; // quiet time after the last scroll event
  const BOOKS_OWN_SCROLL_MS = 600; // covers a smooth glide plus its ease-out tail

  function initBooks(track: HTMLElement) {
    const originals = Array.from(track.children) as HTMLElement[];
    const count = originals.length;

    // Measured before cloning, or the track would always look scrollable.
    const overflows =
      track.scrollWidth > track.clientWidth + BOOKS_EDGE_TOLERANCE;

    const kids = () => Array.from(track.children) as HTMLElement[];

    // Scroll offset that puts cover `i` at the start of the viewport, read
    // from layout every time so nothing accumulates rounding.
    const offsetOf = (i: number) => {
      const k = kids();
      return k[i].offsetLeft - k[0].offsetLeft;
    };

    if (!(count >= 2 && overflows)) {
      // Every cover fits: the arrows just walk the list and stop at the ends.
      let plain = 0;
      const step = (d: number) => {
        plain = Math.min(Math.max(plain + d, 0), count - 1);
        track.scrollTo({
          left: offsetOf(plain),
          behavior: prefersReducedMotion ? 'auto' : 'smooth',
        });
      };
      booksPrev?.addEventListener('click', () => step(-1));
      booksNext?.addEventListener('click', () => step(1));
      return;
    }

    const clone = (el: HTMLElement) => {
      const copy = el.cloneNode(true) as HTMLElement;
      copy.setAttribute('aria-hidden', 'true');
      copy.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1'));
      return copy;
    };
    track.prepend(...originals.map(clone));
    track.append(...originals.map(clone));

    // Indices [count, 2*count) are the real covers, between the two copies.
    let index = count;

    // A smooth glide stops emitting scroll events during its 1px-per-frame
    // tail, which opens a gap longer than BOOKS_SETTLE_MS. The settle handler
    // below used to fire into that gap, resync the index to a half-finished
    // position and fold against the running animation — measured as net steps
    // of +1071 then +135 where -242 was due. So our own scrolls are marked and
    // the handler ignores them; arrow navigation folds in `turn` instead.
    let ownScrollUntil = 0;
    const markOwn = () => {
      ownScrollUntil = performance.now() + BOOKS_OWN_SCROLL_MS;
    };

    const jump = (i: number) => {
      index = i;
      markOwn();
      track.scrollTo({ left: offsetOf(i), behavior: 'auto' });
    };
    const glide = (i: number) => {
      index = i;
      markOwn();
      track.scrollTo({
        left: offsetOf(i),
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
      });
    };

    jump(index);

    // Bring the resting index back into the middle copy. The copies are
    // identical, and the target is a cover's own offset, so this is invisible.
    const fold = () => {
      if (index < count) jump(index + count);
      else if (index >= 2 * count) jump(index - count);
    };

    const turn = (step: number) => {
      fold(); // before the animation, so it never races the scroll
      glide(index + step);
    };

    booksPrev?.addEventListener('click', () => turn(-1));
    booksNext?.addEventListener('click', () => turn(1));

    // A touch swipe moves the scroll without going through `index`. Resync
    // from layout once it settles, then fold if it drifted out of the middle
    // copy. Arrow navigation is excluded: it keeps `index` itself and folds on
    // the next click, before animating.
    let settleTimer: ReturnType<typeof setTimeout> | undefined;
    track.addEventListener(
      'scroll',
      () => {
        clearTimeout(settleTimer);
        settleTimer = setTimeout(() => {
          if (performance.now() < ownScrollUntil) return;
          const k = kids();
          const base = k[0].offsetLeft;
          const at = track.scrollLeft;
          let nearest = 0;
          for (let n = 1; n < k.length; n++) {
            if (
              Math.abs(k[n].offsetLeft - base - at) <
              Math.abs(k[nearest].offsetLeft - base - at)
            ) {
              nearest = n;
            }
          }
          index = nearest;
          fold();
        }, BOOKS_SETTLE_MS);
      },
      { passive: true }
    );

    // --book-w is a clamp(), so every offset changes with the viewport.
    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => jump(index), 150);
    });
  }

  if (booksTrack) initBooks(booksTrack);
</script>
