---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---
<Layout title="Hybris — An Ancient Conflict, Reimagined | Metron Showrunners">

  <main class="keyart-wrap">
    <div class="keyart">
      <img
        src="/images/hybris-keyart.png?v=1"
        alt="Hybris — An Ancient Conflict, Reimagined. A Metron Showrunners Original Epic Drama Series."
        class="keyart-img"
      />
      <!-- Clickable overlay aligned with the baked-in 'Project' button.
           TODO: trocar href="#" pela URL de destino do projeto. -->
      <a href="#" class="project-hotspot" aria-label="Project"></a>
    </div>
  </main>

</Layout>

<style>
  /* Aspect ratio of the key art: 1684 x 1190 */
  .keyart-wrap {
    position: fixed;
    inset: 0;
    overflow: hidden;
    /* Cream letterbox shown only where the image doesn't reach (mobile contain) */
    background-color: #cabf9d;
  }

  .keyart {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    /* Contain — always show the whole poster, letterboxed on the cream
       background so nothing (logo, footer, Project button) is cropped.
       min() keeps the image aspect while fitting fully inside the viewport. */
    width:  min(100vw, 100vh * 1684 / 1190);
    height: min(100vh, 100vw * 1190 / 1684);
  }

  .keyart-img {
    display: block;
    width: 100%;
    height: 100%;
    /* Box already matches the image aspect, so no distortion. */
    object-fit: fill;
  }

  /* Real, clickable button over the baked-in 'Project' pill.
     Coordinates are a % of the image box, so they stay aligned
     under both cover and contain. */
  .project-hotspot {
    position: absolute;
    left: 84.5%;
    top: 90.2%;
    width: 9.5%;
    height: 5.6%;
    border-radius: 999px;
    z-index: 3;
    /* invisible hit area; subtle affordance on hover */
    transition: background-color 0.2s ease;
  }
  .project-hotspot:hover {
    background-color: rgba(255, 255, 255, 0.10);
  }
  .project-hotspot:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.85);
    outline-offset: 2px;
  }
</style>
