---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const year = new Date().getFullYear();
---
<Layout title="Hybris — An Ancient Conflict, Reimagined | Metron Showrunners">

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/glightbox@3.3.1/dist/css/glightbox.min.css"
  />
  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/glightbox@3.3.1/dist/js/glightbox.min.js"
  ></script>

  <main class="keyart-wrap">
    <div
      class="keyart"
      role="region"
      aria-roledescription="carousel"
      aria-label="Metron Showrunners key art"
    >
      <div
        class="slide is-active"
        data-slide="0"
        role="group"
        aria-roledescription="slide"
        aria-label="1 of 6: Laya"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/laya-keyart-portrait.jpg?v=5"
          />
          <img
            src="/images/laya-keyart.jpg?v=5"
            alt="Laya — For love, she embraced eternity and relinquished her humanity. A Metron Showrunners Original Feature Film. Coming soon."
            class="keyart-img"
          />
        </picture>
        <a
          href="https://youtu.be/bXL5xmmQPys"
          class="footer-link glightbox"
          aria-label="Play the Laya teaser"
        ></a>
      </div>

      <div
        class="slide"
        data-slide="1"
        role="group"
        aria-roledescription="slide"
        aria-label="2 of 6: Inter/Sessions"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/intersessions-keyart-portrait.jpg?v=2"
          />
          <img
            src="/images/intersessions-keyart.jpg?v=2"
            alt="Inter/Sessions — No one stands alone. A Metron Showrunners Original Limited Series. Coming soon."
            class="keyart-img"
          />
        </picture>
      </div>

      <div
        class="slide"
        data-slide="2"
        role="group"
        aria-roledescription="slide"
        aria-label="3 of 6: Hybris"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/hybris-keyart-portrait.jpg?v=3"
          />
          <img
            src="/images/hybris-keyart.jpg?v=3"
            alt="Hybris — An Ancient Conflict, Reimagined. A Metron Showrunners Original Epic Drama Series."
            class="keyart-img"
          />
        </picture>
        <a
          href="https://files.hybris.world/"
          class="footer-link"
          aria-label="Hybris Project — access the materials"
        ></a>
      </div>

      <div
        class="slide"
        data-slide="3"
        role="group"
        aria-roledescription="slide"
        aria-label="4 of 6: Adorable Mrs. Steele"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/mrs-steele-keyart-portrait.jpg?v=2"
          />
          <img
            src="/images/mrs-steele-keyart.jpg?v=2"
            alt="Adorable Mrs. Steele. A Metron Showrunners Original Comedy Feature Film. Coming soon."
            class="keyart-img"
          />
        </picture>
      </div>

      <div
        class="slide"
        data-slide="4"
        role="group"
        aria-roledescription="slide"
        aria-label="5 of 6: Not Even Death"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/not-even-death-keyart-portrait.jpg?v=2"
          />
          <img
            src="/images/not-even-death-keyart.jpg?v=2"
            alt="Not Even Death — someone had to give up. A Metron Showrunners Original One-Minute Film."
            class="keyart-img is-ned"
          />
        </picture>
        <a
          href="https://files-ned.metronshowrunners.com/"
          class="footer-link"
          aria-label="Not Even Death — view the script"
        ></a>
      </div>

      <div
        class="slide"
        data-slide="5"
        role="group"
        aria-roledescription="slide"
        aria-label="6 of 6: Cell Phone"
      >
        <picture>
          <source
            media="(orientation: portrait)"
            srcset="/images/cell-phone-keyart-portrait.jpg?v=2"
          />
          <img
            src="/images/cell-phone-keyart.jpg?v=2"
            alt="Cell Phone — you're free to go. A Metron Showrunners Original Vertical Mobile Film. Coming soon."
            class="keyart-img"
          />
        </picture>
      </div>

      <button
        type="button"
        class="nav-arrow prev"
        data-nav="prev"
        aria-label="Previous key art"
      >
        <span aria-hidden="true">&#8249;</span>
      </button>
      <button
        type="button"
        class="nav-arrow next"
        data-nav="next"
        aria-label="Next key art"
      >
        <span aria-hidden="true">&#8250;</span>
      </button>

      <div class="dots" role="tablist" aria-label="Choose key art">
        <button
          type="button"
          class="dot is-active"
          data-dot="0"
          role="tab"
          aria-selected="true"
          aria-label="Show slide 1: Laya"
        ></button>
        <button
          type="button"
          class="dot"
          data-dot="1"
          role="tab"
          aria-selected="false"
          aria-label="Show slide 2: Inter/Sessions"
        ></button>
        <button
          type="button"
          class="dot"
          data-dot="2"
          role="tab"
          aria-selected="false"
          aria-label="Show slide 3: Hybris"
        ></button>
        <button
          type="button"
          class="dot"
          data-dot="3"
          role="tab"
          aria-selected="false"
          aria-label="Show slide 4: Adorable Mrs. Steele"
        ></button>
        <button
          type="button"
          class="dot"
          data-dot="4"
          role="tab"
          aria-selected="false"
          aria-label="Show slide 5: Not Even Death"
        ></button>
        <button
          type="button"
          class="dot"
          data-dot="5"
          role="tab"
          aria-selected="false"
          aria-label="Show slide 6: Cell Phone"
        ></button>
      </div>
    </div>
  </main>

  <section class="books" aria-labelledby="books-title">
    <div class="books-header">
      <h2 id="books-title" class="books-title">Metron Publishing</h2>
      <p class="books-subtitle">Stories beyond the screen.</p>
    </div>
    <div class="books-carousel">
      <button
        type="button"
        class="books-nav prev"
        data-books-nav="prev"
        aria-label="Previous titles"
      >
        <span aria-hidden="true">&#8249;</span>
      </button>
      <div class="books-track">
      <div class="book-item">
        <a
          href="https://a.co/d/074VoWqo"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Buy Hybris, Book 1: Melissa's Story — opens in a new window"
        >
          <img
            class="book-cover"
            src="/images/books/hybris-livro-1-melissa.jpg?v=1"
            alt="Hybris, Book 1: Melissa's Story — inspired by the myth of Medusa. By Julio Camacho and Guilherme Schlogel, adapted by Rafael Doyle. Metron Publishing."
            loading="lazy"
            width="900"
            height="1414"
          />
        </a>
        <div class="book-caption">
          <p class="book-caption-title">Book 1: Melissa's Story</p>
          <div class="book-caption-tags">
            <span class="book-caption-tag">Medusa Myth</span>
            <span class="book-caption-tag">2024</span>
          </div>
        </div>
      </div>
      <div class="book-item">
        <a
          href="https://a.co/d/0gX00Jsc"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Buy Hybris, Book 2: Peter's Story — opens in a new window"
        >
          <img
            class="book-cover"
            src="/images/books/hybris-livro-2-peter.jpg?v=1"
            alt="Hybris, Book 2: Peter's Story — inspired by the myth of Perseus. By Julio Camacho and Guilherme Schlogel, adapted by Rafael Doyle. Metron Publishing."
            loading="lazy"
            width="900"
            height="1414"
          />
        </a>
        <div class="book-caption">
          <p class="book-caption-title">Book 2: Peter's Story</p>
          <div class="book-caption-tags">
            <span class="book-caption-tag">Perseus Myth</span>
            <span class="book-caption-tag">2025</span>
          </div>
        </div>
      </div>
      <div class="book-item">
        <a
          href="https://a.co/d/04kTKcmm"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Buy Hybris, Book 3: Matthew's Story — opens in a new window"
        >
          <img
            class="book-cover"
            src="/images/books/hybris-livro-3-matthew.jpg?v=1"
            alt="Hybris, Book 3: Matthew's Story — inspired by the myth of Midas. By Julio Camacho and Guilherme Schlogel, adapted by Rafael Doyle. Metron Publishing."
            loading="lazy"
            width="900"
            height="1414"
          />
        </a>
        <div class="book-caption">
          <p class="book-caption-title">Book 3: Matthew's Story</p>
          <div class="book-caption-tags">
            <span class="book-caption-tag">Midas Myth</span>
            <span class="book-caption-tag">2026</span>
          </div>
        </div>
      </div>
      <div class="book-item">
        <img
          class="book-cover"
          src="/images/books/hybris-livro-4-neville.jpg?v=1"
          alt="Hybris, Book 4: Neville's Story — inspired by the myth of Narcissus. By Julio Camacho and Guilherme Schlogel, adapted by Rafael Doyle. Metron Publishing."
          loading="lazy"
          width="900"
          height="1414"
        />
        <div class="book-caption">
          <p class="book-caption-title">Book 4: Neville's Story</p>
          <div class="book-caption-tags">
            <span class="book-caption-tag">Narcissus Myth</span>
            <span class="book-caption-tag book-caption-tag--coming">Coming October 2026</span>
          </div>
        </div>
      </div>
      <div class="book-item">
        <img
          class="book-cover"
          src="/images/books/hybris-livro-5-benedict.jpg?v=1"
          alt="Hybris, Book 5: Benedict's Story — inspired by the myth of Bellerophon. By Julio Camacho and Guilherme Schlogel, adapted by Rafael Doyle. Metron Publishing."
          loading="lazy"
          width="900"
          height="1414"
        />
        <div class="book-caption">
          <p class="book-caption-title">Book 5: Benedict's Story</p>
          <div class="book-caption-tags">
            <span class="book-caption-tag">Bellerophon Myth</span>
            <span class="book-caption-tag book-caption-tag--coming">Coming March 2027</span>
          </div>
        </div>
      </div>
      <div class="book-item">
        <img
          class="book-cover"
          src="/images/books/hybris-livro-6-theo.jpg?v=1"
          alt="Hybris, Book 6: Theo's Story — inspired by a myth of Zeus. By Julio Camacho and Guilherme Schlogel, adapted by Rafael Doyle. Metron Publishing."
          loading="lazy"
          width="900"
          height="1414"
        />
        <div class="book-caption">
          <p class="book-caption-title">Book 6: Theo's Story</p>
          <div class="book-caption-tags">
            <span class="book-caption-tag">Zeus Myth</span>
            <span class="book-caption-tag book-caption-tag--coming">Coming October 2027</span>
          </div>
        </div>
      </div>
      <div class="book-item">
        <img
          class="book-cover"
          src="/images/books/laya-livro.jpg?v=1"
          alt="Laya, by Julio Camacho. Metron Publishing."
          loading="lazy"
          width="900"
          height="1414"
        />
        <div class="book-caption">
          <p class="book-caption-title">Laya</p>
          <div class="book-caption-tags">
            <span class="book-caption-tag book-caption-tag--coming">Coming 2027</span>
          </div>
        </div>
      </div>
      </div>
      <button
        type="button"
        class="books-nav next"
        data-books-nav="next"
        aria-label="Next titles"
      >
        <span aria-hidden="true">&#8250;</span>
      </button>
    </div>
  </section>

  <footer class="site-footer">
    <p class="site-footer-brand">Metron Showrunners</p>
    <nav class="site-footer-links" aria-label="Project links">
      <a href="https://youtu.be/bXL5xmmQPys" class="glightbox">Laya Trailer</a>
      <span class="site-footer-sep" aria-hidden="true">&#183;</span>
      <a href="https://files.hybris.world/">Hybris Project</a>
      <span class="site-footer-sep" aria-hidden="true">&#183;</span>
      <a href="https://files-ned.metronshowrunners.com/">Not Even Death Script</a>
    </nav>
    <p class="site-footer-copy">&#169; {year} Metron Showrunners. All rights reserved.</p>
  </footer>

</Layout>

<style>
  .keyart-wrap {
    position: relative;
    width: 100%;
    /* dvh tracks the real visible viewport on mobile (browser bar
       shows/hides) — plain vh measures as if it were always hidden, so
       it over/under-shoots. vh fallback for browsers without dvh. */
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    /* Only shows where the image doesn't reach. Matches the page background
       (body, global.css) and the Books section below, so the whole page
       reads as one dark canvas instead of a cream flash/letterbox. */
    background-color: #05091a;
  }

  /* Box with 16:9 aspect, fully inside the viewport. Changed from
     3070x2304 (~4:3) to 16:9 on 2026-09-18: on a wide/ultrawide monitor
     the old 4:3 was limited by height and left huge cream-colored bars on
     the sides. The 6 landscape art pieces already come in that format.

     The height, however, no longer locks to 100vw*9/16: that ceiling
     always forces the exact 16:9 aspect, and on more "square" screens
     (tablet in landscape, resized window) it left huge horizontal bars on
     top and bottom. Instead it only shrinks down to an aspect floor of
     1.45 — below that the art gets cropped on the sides via object-fit:
     cover (see .keyart-img) instead of the box continuing to shrink. 1.45
     was chosen because the side crop it produces (~9.2% on each side)
     stays under the safety margin measured pixel-by-pixel on the art:
     Laya's logo at ~11.4% from the left edge (the tightest of any
     logo/text), Hybris's man at ~10.8% from the left. Not Even Death has
     ~0 margin on the right (title flush against the edge), so it doesn't
     depend on this margin — see object-position on .is-ned. 2026-09-19:
     it was already 1.6 (crop ~5%); lowered to crop more as requested, but
     without blowing past Laya's margin — don't lower it further without
     remeasuring the art pixel-by-pixel. */
  .keyart {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width:  min(100vw, 100vh * 16 / 9);
    height: min(100vh, 100vw / 1.45);
    /* Height of the drawn art. Used to size overlaid text without relying
       on plain vh, which is wrong when the box is width-constrained. */
    --art-h: min(100vh, 100vw / 1.45);
  }

  /* Portrait (phone): the portrait art covers the whole screen (cropped
     via object-fit: cover), with no fixed-aspect box or cream bars.
     Fills .keyart-wrap via inset (not 100vw/100vh): vh units on mobile
     follow the "large viewport" (as if the browser bar were hidden),
     bigger than the actually visible area — with top:50%/translate(-50%)
     that overflowed symmetrically on top AND bottom, cropping the footer
     bar even with object-position: bottom. Inheriting the wrap's size
     (which via position:fixed already tracks the real visible viewport)
     avoids the mismatch. */
  @media (orientation: portrait) {
    .keyart {
      inset: 0;
      top: auto;
      left: auto;
      transform: none;
      width: 100%;
      height: 100%;
      /* In portrait the art is cropped by object-fit: cover, so what
         matters is the size of the drawn IMAGE, not the box. */
      --art-h: max(100vh, 100vw * 2329 / 1313);
    }
  }

  /* Stacked slides; the crossfade is opacity only. visibility disappears
     with a delay so the hidden slide's link isn't focusable/clickable. */
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease, visibility 0s linear 0.8s;
    z-index: 1;
  }
  .slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.8s ease, visibility 0s linear 0s;
    z-index: 2;
  }

  .keyart-img {
    display: block;
    width: 100%;
    height: 100%;
    /* cover, not fill: with .keyart's 1.6 aspect floor (above), the
       landscape box doesn't always match the art's 16:9 exactly — fill
       would stretch the image. Cover crops without distorting; since the
       box never gets "wider" than 16:9 (only more "square"), the crop is
       always on the sides, never top/bottom — hence object-position: top
       being just extra insurance, not something that currently kicks in. */
    object-fit: cover;
    object-position: center top;
  }

  /* Not Even Death has ~0 margin on the landscape art's right edge (the
     "H" in DEATH nearly touches pixel 9216 of 9216). Anchored to the
     right, any side crop falls entirely on the left (rain background, no
     text), and the right edge is never touched. */
  .keyart-img.is-ned {
    object-position: right top;
  }

  @media (orientation: portrait) {
    .keyart-img {
      object-fit: cover; /* full screen, cropping edges if needed */
      /* 2026-09-19: the new portrait art also has the button drawn at the
         top (same pill as landscape), no longer the footer bar — so the
         crop now has to protect the TOP, not the bottom anymore. On a
         common device aspect (narrower than the art's 0.5625) cover crops
         the SIDES, not top/bottom, so "top" here is extra insurance — same
         reasoning as .keyart-img (landscape) above. */
      object-position: center top;
    }

    /* Not Even Death keeps the title nearly flush against the right edge
       on the new portrait art too (~0 margin, same as landscape). Anchored
       to the right, the side crop falls entirely on the left. */
    .keyart-img.is-ned {
      object-position: right top;
    }
  }

  /* Clickable button over the pill drawn on the art (top-center). Measured
     pixel-by-pixel on the 6 new art pieces — all with the button in almost
     the same spot, ~x 32%–38% to 64%–68% (landscape 9216 / portrait
     2916–2920) and y 0–5.5% — and generously rounded into a single
     rectangle that covers all six. Inter/Sessions, Mrs. Steele and Cell
     Phone have the same pill design ("Coming Soon") but no destination:
     they stay without an <a> element in the HTML. Art changed, remeasure. */
  .footer-link {
    position: absolute;
    left: 44%;
    right: 44%;
    top: 0;
    bottom: 94.8%;
    z-index: 3;
    transition: background-color 0.2s ease;
  }

  /* In portrait, object-fit: cover (above) crops the SIDES of the art to
     cover devices narrower than its 0.5625 — the narrower the device, the
     more the art "zooms" and the further out (toward the edges) the
     button appears to land on screen. On the narrowest common device
     (~0.46, e.g. iPhone 12/Pro Max) this pushes the button out to about
     28%–72%; that's why this box is wider than the landscape one (which
     doesn't suffer this shift, since its box is always >= 1.45 aspect). */
  @media (orientation: portrait) {
    .footer-link {
      left: 25%;
      right: 25%;
      top: 0;
      bottom: 94%;
    }
  }

  .footer-link:hover {
    background-color: rgba(255, 255, 255, 0.14);
  }
  .footer-link:focus-visible {
    outline: 2px solid rgba(26, 18, 10, 0.75); /* dark: the background here is light */
    outline-offset: -2px;
  }

  /* Side arrows, centered on the art's height (above the footer bar,
     which sits only in the bottom third). */
  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.28);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .nav-arrow:hover {
    background: rgba(0, 0, 0, 0.45);
    transform: translateY(-50%) scale(1.08);
  }
  .nav-arrow:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.95);
    outline-offset: 2px;
  }
  .nav-arrow.prev {
    left: 3%;
  }
  .nav-arrow.next {
    right: 3%;
  }

  /* Dots in the bottom third: in landscape the clickable button is at the
     top, far from here; in portrait (old art) they sit above the footer
     bar, to avoid clashing with the clickable strip. */
  .dots {
    position: absolute;
    left: 50%;
    bottom: 12%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 4;
  }

  .dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.85);
    background: rgba(0, 0, 0, 0.25);
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .dot:hover {
    transform: scale(1.15);
  }
  .dot.is-active {
    background: rgba(255, 255, 255, 0.95);
  }
  .dot:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.95);
    outline-offset: 2px;
  }

  /* Second section: the studio's books, below the key art (which now only
     takes up 100dvh instead of the whole screen via position: fixed). */
  .books {
    background-color: #05091a;
    color: #f2ede2;
    padding: 64px 6% 96px;
  }

  .books-header {
    max-width: 1400px;
    margin: 0 auto 40px;
  }

  .books-title {
    margin: 0;
    font-size: clamp(24px, 4vw, 34px);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f2ede2;
  }

  .books-subtitle {
    margin: 8px 0 0;
    font-size: clamp(14px, 2vw, 18px);
    color: #f2ede2;
    opacity: 0.65;
  }

  /* Horizontal carousel instead of a grid: covers were reading too big
     stacked 3-per-row, so all titles now sit in a single scroll-snapped
     row. Cards are a fixed-ish width (--book-w, fluid between a phone and
     a wide desktop floor/ceiling) rather than dividing the container into
     a set number of columns — how many fit per screen is just whatever
     width allows, which lands on ~2 on a phone in portrait without a
     dedicated breakpoint. .is-landscape (unused today, kept for a future
     landscape cover) spans double a card's width plus the gap. */
  .books-carousel {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .books-track {
    --book-w: clamp(130px, 15vw, 190px);
    --books-gap: 52px;
    display: flex;
    gap: var(--books-gap);
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 14px 4px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .books-track::-webkit-scrollbar {
    display: none;
  }

  .book-item {
    flex: 0 0 var(--book-w);
    scroll-snap-align: start;
  }

  .book-item.is-landscape {
    flex-basis: calc(2 * var(--book-w) + var(--books-gap));
  }

  .book-cover {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
    /* Lifts the cover off the dark background; grows on hover/focus so the
       picked title visibly "pops" toward the viewer. */
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.55);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .book-item:hover .book-cover,
  .book-item a:focus-visible .book-cover {
    box-shadow: 0 18px 34px rgba(0, 0, 0, 0.8);
    transform: translateY(-6px) scale(1.04);
  }

  /* Link that covers the whole cover (e.g.: book for sale). The image is
     already the clickable content, so the link has no visible text of its
     own — just the aria-label. The caption below is separate, plain text
     naming the book, not part of the link. */
  .book-item a {
    display: block;
  }
  .book-item a:focus-visible {
    outline: 2px solid rgba(242, 237, 226, 0.85);
    outline-offset: 2px;
  }

  /* Styled after a Macmillan Publishers book-grid reference: plain-weight
     title, smaller muted byline, small rounded tag — adapted to the dark
     background instead of that reference's white one. */
  .book-caption {
    margin: 12px 0 0;
    text-align: left;
  }

  .book-caption-title {
    margin: 0;
    font-size: 14px;
    line-height: 1.3;
    font-weight: 600;
    color: #f2ede2;
  }

  .book-caption-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  .book-caption-tag {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 999px;
    background: rgba(242, 237, 226, 0.12);
    color: #f2ede2;
    font-size: 11px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* Pre-release titles: warm accent (the site's old letterbox cream) so
     "coming soon" reads as distinct from a myth tag or a release year. */
  .book-caption-tag--coming {
    background: rgba(202, 191, 157, 0.22);
    color: #cabf9d;
  }

  .books-nav {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(242, 237, 226, 0.12);
    color: #f2ede2;
    font-size: 22px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .books-nav:hover {
    background: rgba(242, 237, 226, 0.22);
    transform: scale(1.08);
  }
  .books-nav:focus-visible {
    outline: 2px solid rgba(242, 237, 226, 0.85);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .books-nav {
      width: 32px;
      height: 32px;
      font-size: 18px;
    }
  }

  /* Closing footer: same dark canvas as .books, so the page ends as one
     continuous surface instead of a third background color. */
  .site-footer {
    background-color: #05091a;
    color: #f2ede2;
    padding: 32px 6% 40px;
    border-top: 1px solid rgba(242, 237, 226, 0.14);
    text-align: center;
  }

  .site-footer-brand {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .site-footer-links {
    margin: 14px 0 0;
    font-size: 13px;
  }

  .site-footer-links a {
    color: #f2ede2;
    text-decoration: none;
    border-bottom: 1px solid rgba(242, 237, 226, 0.4);
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }

  .site-footer-links a:hover,
  .site-footer-links a:focus-visible {
    border-color: rgba(242, 237, 226, 0.9);
  }

  .site-footer-links a:focus-visible {
    outline: 2px solid rgba(242, 237, 226, 0.85);
    outline-offset: 3px;
  }

  .site-footer-sep {
    margin: 0 10px;
    opacity: 0.5;
  }

  .site-footer-copy {
    margin: 18px 0 0;
    font-size: 11px;
    opacity: 0.5;
  }
</style>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.dot'));
  const prevButton = document.querySelector<HTMLButtonElement>('[data-nav="prev"]');
  const nextButton = document.querySelector<HTMLButtonElement>('[data-nav="next"]');
  const AUTOPLAY_MS = 6000;
  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  let current = 0;
  let timer: ReturnType<typeof setInterval> | undefined;

  function show(index: number) {
    current = index;
    slides.forEach((slide, i) =>
      slide.classList.toggle('is-active', i === index)
    );
    dots.forEach((dot, i) => {
      dot.classList.toggle('is-active', i === index);
      dot.setAttribute('aria-selected', String(i === index));
    });
  }

  function next() {
    show((current + 1) % slides.length);
  }

  function prev() {
    show((current - 1 + slides.length) % slides.length);
  }

  function restartAutoplay() {
    if (prefersReducedMotion || slides.length < 2) return;
    clearInterval(timer);
    timer = setInterval(next, AUTOPLAY_MS);
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      show(i);
      restartAutoplay();
    });
  });

  prevButton?.addEventListener('click', () => {
    prev();
    restartAutoplay();
  });

  nextButton?.addEventListener('click', () => {
    next();
    restartAutoplay();
  });

  restartAutoplay();

  // @ts-ignore — global from the GLightbox CDN <script>, no type declarations.
  const lightbox = GLightbox({ selector: '.glightbox' });
  // The carousel autoplay keeps advancing slides behind the video overlay
  // otherwise — pause it while the lightbox is open, resume on close.
  lightbox.on('open', () => clearInterval(timer));
  lightbox.on('close', () => restartAutoplay());

  const booksTrack = document.querySelector<HTMLElement>('.books-track');
  const booksPrev = document.querySelector<HTMLButtonElement>(
    '[data-books-nav="prev"]'
  );
  const booksNext = document.querySelector<HTMLButtonElement>(
    '[data-books-nav="next"]'
  );

  // Native scroll clamps at both ends, so a plain scrollBy does nothing once
  // you hit an edge. Wrap instead: jump (no animation, so it reads as a
  // loop rather than a slow scroll back across every cover) to the far edge
  // before scrolling, so prev/next always has somewhere to go.
  const BOOKS_EDGE_TOLERANCE = 12; // rounding/padding leave scrollLeft a few px off 0 at rest
  booksPrev?.addEventListener('click', () => {
    if (!booksTrack) return;
    if (booksTrack.scrollLeft <= BOOKS_EDGE_TOLERANCE) {
      booksTrack.scrollTo({ left: booksTrack.scrollWidth, behavior: 'auto' });
    } else {
      booksTrack.scrollBy({ left: -booksTrack.clientWidth, behavior: 'smooth' });
    }
  });
  booksNext?.addEventListener('click', () => {
    if (!booksTrack) return;
    if (
      booksTrack.scrollLeft >=
      booksTrack.scrollWidth - booksTrack.clientWidth - BOOKS_EDGE_TOLERANCE
    ) {
      booksTrack.scrollTo({ left: 0, behavior: 'auto' });
    } else {
      booksTrack.scrollBy({ left: booksTrack.clientWidth, behavior: 'smooth' });
    }
  });
</script>
